/* Ljudeffekter */
let AC=null;
function sfx(kind){
  try{AC=AC||new (window.AudioContext||window.webkitAudioContext)();if(AC.state==="suspended")AC.resume();
    const t=AC.currentTime;
    const n=(f,s,d,type,v)=>{const o=AC.createOscillator(),g=AC.createGain();o.type=type||"sine";o.frequency.value=f;
      g.gain.setValueAtTime(0,t+s);g.gain.linearRampToValueAtTime(v||.16,t+s+.015);g.gain.exponentialRampToValueAtTime(.0001,t+s+d);
      o.connect(g).connect(AC.destination);o.start(t+s);o.stop(t+s+d+.02);};
    if(kind==="good"){n(660,0,.14,"triangle");n(990,.08,.22,"triangle");}
    else if(kind==="bad"){n(220,0,.22,"square",.07);n(170,.1,.3,"square",.07);}
    else if(kind==="win"){[523,659,784,1047].forEach((f,i)=>n(f,i*.11,.3,"triangle",.15));}
    else if(kind==="tap"){n(520,0,.05,"sine",.06);}
  }catch(e){}
}

