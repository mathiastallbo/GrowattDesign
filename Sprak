<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Språkstigen</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap">
<style>
:root{
  color-scheme:light;
  --bg:#ffffff; --surface:#ffffff; --surface-2:#f4f7f9;
  --ink:#3b4346; --muted:#7d878c; --line:#e3e8eb; --line-d:#cfd6da;
  --green:#4cc34f; --green-d:#3a9e3d; --green-bg:#dcf7cf; --green-ink:#3b8a2e;
  --red:#f25c5c; --red-d:#cc3f3f; --red-bg:#ffe0e0; --red-ink:#d03a3a;
  --blue:#2fa7f0; --blue-d:#1b86c7; --blue-bg:#dff2ff;
  --purple:#9b5de5; --purple-d:#7b3fc4;
  --orange:#ff9f1c; --orange-d:#d98200;
  --pink:#ef5b9c; --pink-d:#c93d7c;
  --teal:#1cb5ac; --teal-d:#12908a;
  --gold:#ffc425; --gold-d:#e0a400;
  --locked:#e3e8eb; --locked-d:#c9d1d5; --locked-ink:#a9b3b8;
  --art-m:#2f7fd8; --art-f:#d8456b; --art-n:#2e9d52;
  --brezel:#c77a2c; --brezel-d:#9c5a1a;
  --fruit:#ff9a1f; --fruit-d:#dd7400;
  --crust:#e9a13b; --crust-d:#b56a14;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --bg:#131f24; --surface:#131f24; --surface-2:#1d2c33;
    --ink:#eef4f7; --muted:#93a6ae; --line:#35454d; --line-d:#27363d;
    --green-bg:#1c3322; --green-ink:#86e27d;
    --red-bg:#3a1e22; --red-ink:#ff8d8d;
    --blue-bg:#16364a;
    --locked:#35454d; --locked-d:#27363d; --locked-ink:#5e727b;
    --art-m:#6fb2ff; --art-f:#ff7fa0; --art-n:#6fd68f;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#131f24; --surface:#131f24; --surface-2:#1d2c33;
  --ink:#eef4f7; --muted:#93a6ae; --line:#35454d; --line-d:#27363d;
  --green-bg:#1c3322; --green-ink:#86e27d;
  --red-bg:#3a1e22; --red-ink:#ff8d8d;
  --blue-bg:#16364a;
  --locked:#35454d; --locked-d:#27363d; --locked-ink:#5e727b;
  --art-m:#6fb2ff; --art-f:#ff7fa0; --art-n:#6fd68f;
}

*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:"Nunito","Varela Round",system-ui,-apple-system,"Segoe UI",sans-serif;font-weight:700;font-size:16px;
  -webkit-tap-highlight-color:transparent}
button{font-family:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
h1,h2,h3{text-wrap:balance;margin:0}
p{margin:0}
.icon{width:24px;height:24px;flex:none}

/* ---------- App shell ---------- */
.shell{max-width:620px;margin:0 auto;padding-inline:16px;padding-bottom:110px}
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:2px solid var(--line)}
.topbar-in{max-width:620px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.flag{width:34px;height:26px;border-radius:7px;overflow:hidden;display:grid;grid-template-rows:1fr 1fr 1fr;box-shadow:0 0 0 2px var(--line);flex:none}
.flag.de i:nth-child(1){background:#222}.flag.de i:nth-child(2){background:#dd2a2a}.flag.de i:nth-child(3){background:#ffce00}
.flag.es{grid-template-rows:1fr 2fr 1fr}
.flag.es i:nth-child(1),.flag.es i:nth-child(3){background:#c8102e}.flag.es i:nth-child(2){background:#ffc400}
.flag.fr{grid-template-rows:1fr;grid-template-columns:1fr 1fr 1fr}
.flag.fr i:nth-child(1){background:#0055a4}.flag.fr i:nth-child(2){background:#fff}.flag.fr i:nth-child(3){background:#ef4135}
.flag.big{width:64px;height:48px;border-radius:11px}
.flagbtn{background:none;border:2px solid transparent;border-radius:12px;padding:4px;display:flex;align-items:center;gap:6px}
.flagbtn:hover{border-color:var(--line)}
.stat{display:flex;align-items:center;gap:6px;font-weight:800;font-size:17px;font-variant-numeric:tabular-nums}
.stat.streak{color:var(--orange)} .stat.xp{color:var(--blue)} .stat.hearts{color:var(--red)}
.stat.off{color:var(--locked-ink)}

.bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:20;background:var(--bg);border-top:2px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
.bottomnav-in{max-width:620px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);padding:6px 16px}
.navbtn{background:none;border:2px solid transparent;border-radius:14px;padding:8px 4px;display:flex;flex-direction:column;
  align-items:center;gap:2px;font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.navbtn.on{color:var(--blue);border-color:var(--blue);background:var(--blue-bg)}
.navbtn .icon{width:28px;height:28px}

/* ---------- Buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:16px;
  padding:14px 22px;font-size:15px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;
  background:var(--green);color:#fff;box-shadow:0 4px 0 var(--green-d);transition:transform .06s,box-shadow .06s,filter .15s;min-height:50px}
.btn:hover{filter:brightness(1.05)}
.btn:active:not(:disabled){transform:translateY(4px);box-shadow:0 0 0 var(--green-d)}
.btn:disabled{background:var(--locked);color:var(--locked-ink);box-shadow:0 4px 0 var(--locked-d);cursor:default}
.btn.red{background:var(--red);box-shadow:0 4px 0 var(--red-d)}
.btn.blue{background:var(--blue);box-shadow:0 4px 0 var(--blue-d)}
.btn.ghost{background:var(--surface);color:var(--blue);border:2px solid var(--line);box-shadow:0 4px 0 var(--line)}
.btn.wide{width:100%}

/* ---------- Greeting ---------- */
.greet{display:flex;gap:12px;align-items:center;margin-top:18px;border:2px solid var(--line);border-radius:20px;padding:12px 16px 14px 10px}
.greet svg.mascot{width:84px;flex:none}
.greet-txt{flex:1;min-width:0}
.greet-txt h2{font-size:20px;font-weight:900}
.greet-txt p{color:var(--muted);font-size:15px;margin-top:2px}
.goalrow{display:flex;align-items:center;gap:10px;margin-top:10px;font-size:14px;font-weight:900;color:var(--gold-d);font-variant-numeric:tabular-nums}
.goalbar{flex:1;height:14px;border-radius:99px;background:var(--line);overflow:hidden}
.goalbar i{display:block;height:100%;border-radius:99px;background:var(--gold);transition:width .5s}

/* ---------- Path ---------- */
.practice-row{display:flex;gap:12px;margin:14px 0 0}
.practice-row .btn{flex:1}
.unit{margin-top:22px}
.unit-head{background:var(--u);color:#fff;border-radius:18px;padding:16px 18px;box-shadow:0 5px 0 var(--ud);display:flex;justify-content:space-between;align-items:center;gap:12px}
.unit-kicker{font-size:13px;letter-spacing:.12em;text-transform:uppercase;opacity:.85;font-weight:800}
.unit-head h2{font-size:22px;font-weight:900;margin-top:2px}
.unit-head p.d{font-size:15px;opacity:.92;margin-top:2px;font-weight:700}
.unit-count{font-size:14px;font-weight:900;background:rgba(0,0,0,.14);border-radius:12px;padding:6px 10px;white-space:nowrap}
.nodes{position:relative;display:flex;flex-direction:column;align-items:center;gap:26px;padding:58px 0 14px}
.node-wrap{position:relative;display:flex;flex-direction:column;align-items:center;gap:6px}
.node{width:74px;height:70px;border-radius:50%;border:0;display:grid;place-items:center;background:var(--u);box-shadow:0 7px 0 var(--ud);color:#fff;transition:transform .06s,box-shadow .06s}
.node .icon{width:34px;height:34px}
.node:active{transform:translateY(6px);box-shadow:0 1px 0 var(--ud)}
.node.done{background:var(--gold);box-shadow:0 7px 0 var(--gold-d)}
.node.done:active{box-shadow:0 1px 0 var(--gold-d)}
.node.locked{background:var(--locked);box-shadow:0 7px 0 var(--locked-d);color:var(--locked-ink)}
.node.current{outline:6px solid color-mix(in srgb,var(--u) 25%,transparent);outline-offset:5px}
.node.test{border-radius:22px;width:84px}
.node-label{font-size:14px;color:var(--muted);font-weight:800}
.node-wrap.current .node-label{color:var(--ink)}
.crowns{position:absolute;top:-6px;right:-10px;background:var(--surface);border:2px solid var(--line);border-radius:10px;font-size:12px;font-weight:900;padding:1px 6px;color:var(--gold-d)}
.start-bubble{position:absolute;top:-44px;left:50%;transform:translateX(-50%);background:var(--surface);color:var(--u);border:2px solid var(--line);border-radius:12px;padding:5px 12px;font-weight:900;letter-spacing:.08em;font-size:14px;white-space:nowrap;animation:bob 1.3s ease-in-out infinite}
.start-bubble::after{content:"";position:absolute;left:50%;bottom:-8px;width:12px;height:12px;background:var(--surface);border-right:2px solid var(--line);border-bottom:2px solid var(--line);transform:translateX(-50%) rotate(45deg)}
@keyframes bob{50%{transform:translateX(-50%) translateY(-5px)}}
.path-mascot{position:absolute;top:40%;width:92px;pointer-events:none}
.path-end{text-align:center;color:var(--muted);padding:28px 0 8px;font-weight:800}

/* ---------- Words / profile ---------- */
.page-title{font-size:26px;font-weight:900;margin:22px 0 4px}
.page-sub{color:var(--muted);font-weight:700;margin-bottom:12px}
.wgroup{margin-top:18px;border:2px solid var(--line);border-radius:18px;overflow:hidden}
.wgroup h3{font-size:16px;font-weight:900;padding:12px 16px;background:var(--surface-2);border-bottom:2px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.wgroup h3 small{color:var(--muted);font-weight:800;font-size:13px}
.wrow{display:grid;grid-template-columns:34px 1fr 1fr 40px;align-items:center;gap:10px;padding:10px 12px 10px 16px;border-top:2px solid var(--line)}
.wrow:first-of-type{border-top:0}
.wrow .e{font-size:24px}
.wrow .sv{color:var(--muted);font-weight:700}
.art{font-weight:900}
.art.m{color:var(--art-m)}.art.f{color:var(--art-f)}.art.n{color:var(--art-n)}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:14px;color:var(--muted)}
.wlocked{padding:14px 16px;color:var(--locked-ink);font-weight:800}
.phead{display:flex;align-items:center;gap:16px;margin-top:22px}
.avatar{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:900;font-size:21px;flex:none;background:var(--av,var(--blue))}
.avatar.big{width:76px;height:76px;font-size:34px;box-shadow:0 5px 0 rgba(0,0,0,.15)}
.phead h1{font-size:26px;font-weight:900}
.phead p{color:var(--muted)}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}
.sbox{border:2px solid var(--line);border-radius:16px;padding:14px 16px;display:flex;gap:12px;align-items:center}
.sbox b{display:block;font-size:24px;font-weight:900;font-variant-numeric:tabular-nums;line-height:1.1}
.sbox span{color:var(--muted);font-size:14px}
.sbox .icon{width:30px;height:30px}
.sect{margin-top:24px}
.sect h2{font-size:19px;font-weight:900;margin-bottom:10px}
.gchips{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.gchip{background:var(--surface);border:2px solid var(--line);box-shadow:0 3px 0 var(--line);border-radius:14px;padding:10px 4px;font-weight:900;font-size:16px}
.gchip small{display:block;font-size:12px;color:var(--muted);font-weight:800}
.gchip.on{border-color:var(--blue);background:var(--blue-bg);color:var(--blue-d);box-shadow:0 3px 0 var(--blue)}
.pbtns{margin-top:26px;display:flex;flex-direction:column;gap:12px}

.spk{border:0;background:var(--blue);color:#fff;width:38px;height:38px;border-radius:12px;display:grid;place-items:center;box-shadow:0 3px 0 var(--blue-d);flex:none}
.spk .icon{width:22px;height:22px}
.spk:active{transform:translateY(3px);box-shadow:none}
.spk.big{width:110px;height:92px;border-radius:22px;box-shadow:0 6px 0 var(--blue-d)}
.spk.big .icon{width:48px;height:48px}
.spk.slow{width:64px;height:64px;border-radius:18px;background:var(--surface);color:var(--blue);border:2px solid var(--line);box-shadow:0 4px 0 var(--line)}
.spk.slow .icon{width:30px;height:30px}

/* ---------- Auth / onboarding ---------- */
.auth{position:fixed;inset:0;z-index:45;background:var(--bg);overflow:auto;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.auth-in{max-width:540px;min-height:100%;margin:0 auto;padding:22px 16px;display:flex;flex-direction:column;gap:18px}
.login-hero{display:flex;justify-content:center;align-items:flex-end;gap:0;margin-top:8px}
.login-hero svg.mascot{width:120px}
.login-hero svg.mascot:last-child{margin-left:-14px;transform:translateY(-6px)}
.brand{font-size:clamp(38px,11vw,50px);font-weight:900;color:var(--green);text-align:center;letter-spacing:-.01em;line-height:1}
.tagline{text-align:center;color:var(--muted);font-size:17px;max-width:30ch;margin:0 auto}
.lcard{display:flex;flex-direction:column;gap:12px}
.lcard label{font-weight:900;font-size:17px}
.field{width:100%;font:inherit;font-size:19px;font-weight:800;padding:15px 16px;border:2px solid var(--line);border-radius:16px;background:var(--surface-2);color:var(--ink)}
.field:focus{outline:none;border-color:var(--blue)}
.err{color:var(--red-ink);font-size:15px}
.hint{color:var(--muted);font-size:14px;text-align:center}
.divider{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:13px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
.divider::before,.divider::after{content:"";flex:1;height:2px;background:var(--line)}
.profs{display:flex;flex-direction:column;gap:10px}
.prof{display:flex;align-items:center;gap:14px;text-align:left;padding:12px 14px}
.prof b{display:block;font-size:18px;font-weight:900}
.prof span{color:var(--muted);font-size:14px}
.onb-head{display:flex;align-items:center;gap:14px}
.backbtn{background:none;border:0;color:var(--locked-ink);padding:4px;display:grid;place-items:center}
.backbtn .icon{width:28px;height:28px}
.onb-bar{flex:1;height:16px;border-radius:99px;background:var(--line);overflow:hidden}
.onb-bar i{display:block;height:100%;background:var(--green);border-radius:99px;transition:width .4s}
.onb-body{flex:1;display:flex;flex-direction:column;gap:18px;animation:slidein .28s ease-out}
.onb-foot{position:sticky;bottom:0;background:var(--bg);padding:12px 0 6px;border-top:2px solid var(--line)}
.lead{font-size:28px;line-height:1;width:40px;text-align:center;flex:none}
.row.plain{padding:14px 16px;display:flex;align-items:center;gap:14px}
.row.plain small{display:block;color:var(--muted);font-weight:700;font-size:14px}
.opt.sel small{color:var(--blue-d)}
.summary{border:2px solid var(--line);border-radius:18px;overflow:hidden}
.summary div{display:flex;justify-content:space-between;gap:12px;padding:12px 16px;border-top:2px solid var(--line)}
.summary div:first-child{border-top:0}
.summary span{color:var(--muted)}

/* ---------- Lesson ---------- */
.lesson{position:fixed;inset:0;z-index:40;background:var(--bg);display:grid;grid-template-rows:auto 1fr auto;padding-top:env(safe-area-inset-top,0px)}
.lhead{max-width:620px;width:100%;margin:0 auto;padding:16px 16px 6px;display:flex;align-items:center;gap:14px}
.xbtn{background:none;border:0;color:var(--locked-ink);padding:4px;display:grid;place-items:center}
.xbtn .icon{width:28px;height:28px}
.pbar{flex:1;height:18px;border-radius:99px;background:var(--line);position:relative}
.pbar i{position:absolute;inset:0 auto 0 0;width:0;border-radius:99px;background:var(--green);transition:width .45s cubic-bezier(.3,1.4,.5,1)}
.pbar i::after{content:"";position:absolute;left:10px;right:10px;top:4px;height:5px;border-radius:9px;background:rgba(255,255,255,.35)}
.combo{position:absolute;left:0;top:-22px;font-size:13px;font-weight:900;color:var(--orange);letter-spacing:.06em;text-transform:uppercase;opacity:0;transition:opacity .3s;white-space:nowrap}
.combo.on{opacity:1}
.lhearts{display:flex;align-items:center;gap:5px;color:var(--red);font-weight:900;font-size:18px;font-variant-numeric:tabular-nums}
.lhearts.inf{color:var(--blue)}
.lhearts.hit{animation:hit .5s}
@keyframes hit{20%{transform:scale(1.35)}40%{transform:rotate(-12deg)}60%{transform:rotate(10deg)}}
.lbody{overflow:auto}
.lbody-in{max-width:620px;margin:0 auto;padding:18px 16px 28px;animation:slidein .28s ease-out}
@keyframes slidein{from{opacity:0;transform:translateX(24px)}}
.q-title{font-size:clamp(22px,5.5vw,28px);font-weight:900;margin-bottom:22px}
.q-tag{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--purple);margin-bottom:8px}
.q-tag .icon{width:18px;height:18px}

.opt{background:var(--surface);border:2px solid var(--line);box-shadow:0 4px 0 var(--line);border-radius:16px;transition:transform .06s,box-shadow .06s,background .15s,border-color .15s;position:relative}
.opt:active:not(:disabled){transform:translateY(3px);box-shadow:0 1px 0 var(--line)}
.opt.sel{border-color:var(--blue);background:var(--blue-bg);box-shadow:0 4px 0 var(--blue);color:var(--blue-d)}
.opt.right{border-color:var(--green);background:var(--green-bg);box-shadow:0 4px 0 var(--green);color:var(--green-ink)}
.opt.wrong{border-color:var(--red);background:var(--red-bg);box-shadow:0 4px 0 var(--red);color:var(--red-ink);animation:shake .4s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.opt:disabled{cursor:default}
.key{position:absolute;top:8px;left:10px;font-size:12px;font-weight:900;color:var(--locked-ink);border:2px solid var(--line);border-radius:8px;width:22px;height:22px;display:grid;place-items:center}
.pick-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.pick{padding:22px 10px 16px;display:flex;flex-direction:column;align-items:center;gap:10px}
.pick-emoji{font-size:36px;line-height:1;animation:pop .25s}
.pick-emoji:empty{display:none}
.pick{min-height:118px;justify-content:center}
.pick-word{font-size:18px;font-weight:800}
.rows{display:flex;flex-direction:column;gap:12px}
.row{padding:16px 16px 16px 48px;text-align:left;font-size:18px;font-weight:800}
.row .key{top:50%;transform:translateY(-50%);left:14px}

.prompt{display:flex;align-items:flex-end;gap:12px;margin-bottom:26px}
.prompt svg.mascot{width:96px;flex:none}
.bubble{position:relative;border:2px solid var(--line);border-radius:18px;padding:14px 16px;display:flex;align-items:center;gap:12px;font-size:20px;font-weight:800;margin-bottom:24px;background:var(--surface)}
.bubble::before{content:"";position:absolute;left:-9px;bottom:22px;width:14px;height:14px;background:var(--surface);border-left:2px solid var(--line);border-bottom:2px solid var(--line);transform:rotate(45deg)}
.bubble .tl{text-decoration:underline dotted var(--locked-ink);text-underline-offset:6px}
.bubble.plain{font-size:17px;font-weight:700;margin-bottom:0}

.typecard{display:flex;align-items:center;gap:16px;border:2px solid var(--line);border-radius:18px;padding:16px;margin-bottom:18px}
.typecard .e{font-size:54px;line-height:1}
.typecard .w{font-size:24px;font-weight:900}
.typecard small{display:block;color:var(--muted);font-size:14px;font-weight:700}
.tinput{width:100%;font:inherit;font-size:20px;font-weight:800;color:var(--ink);background:var(--surface-2);border:2px solid var(--line);border-radius:16px;padding:16px;min-height:120px;resize:none}
.tinput:focus{outline:none;border-color:var(--blue)}
.specials{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.specials button{background:var(--surface);border:2px solid var(--line);box-shadow:0 3px 0 var(--line);border-radius:12px;width:46px;height:44px;font-size:19px;font-weight:800}
.specials button:active{transform:translateY(3px);box-shadow:none}

.bank-answer{min-height:122px;display:flex;flex-wrap:wrap;align-content:flex-start;gap:8px;padding:8px 0;background-image:repeating-linear-gradient(to bottom,transparent 0 58px,var(--line) 58px 60px);margin-bottom:26px}
.bank-pool{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.tile{background:var(--surface);border:2px solid var(--line);box-shadow:0 3px 0 var(--line);border-radius:13px;padding:9px 14px;font-size:18px;font-weight:800;min-height:48px}
.tile:active:not(:disabled){transform:translateY(3px);box-shadow:none}
.tile.used{background:var(--line);color:transparent;box-shadow:none;border-color:var(--line);pointer-events:none}
.tile.pop{animation:pop .18s}
@keyframes pop{from{transform:scale(.85)}}
.listen-row{display:flex;justify-content:center;align-items:flex-end;gap:16px;margin:4px 0 26px}

.match{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.match .col{display:flex;flex-direction:column;gap:12px}
.mbtn{padding:15px 10px;font-size:18px;font-weight:800;min-height:58px}
.mbtn.gone{opacity:.35;border-color:var(--line);background:var(--surface);box-shadow:0 4px 0 var(--line);color:var(--muted)}
.mbtn.flash{border-color:var(--green);background:var(--green-bg);color:var(--green-ink);box-shadow:0 4px 0 var(--green)}

.lfoot{border-top:2px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px);transition:background .2s}
.lfoot.ok{background:var(--green-bg);border-color:transparent}
.lfoot.bad{background:var(--red-bg);border-color:transparent}
.lfoot-in{max-width:620px;margin:0 auto;padding:16px;display:flex;flex-direction:column;gap:14px}
.fbox{display:flex;gap:14px;align-items:flex-start;animation:up .25s ease-out}
@keyframes up{from{opacity:0;transform:translateY(12px)}}
.fbadge{width:52px;height:52px;border-radius:50%;background:var(--surface);display:grid;place-items:center;flex:none}
.fbadge .icon{width:30px;height:30px}
.lfoot.ok .fbadge{color:var(--green)} .lfoot.bad .fbadge{color:var(--red)}
.ftitle{font-size:22px;font-weight:900}
.lfoot.ok .ftitle,.lfoot.ok .ftext{color:var(--green-ink)}
.lfoot.bad .ftitle,.lfoot.bad .ftext{color:var(--red-ink)}
.ftext{font-size:17px;font-weight:700;margin-top:4px}
.ftext b{font-weight:900}
.lfoot.bad .btn{background:var(--red);box-shadow:0 4px 0 var(--red-d)}
.lfoot.bad .btn:active{box-shadow:none}

.finish{text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;padding-top:12px}
.finish svg.mascot{width:150px;animation:jump 1s ease-in-out infinite}
@keyframes jump{50%{transform:translateY(-10px) rotate(-3deg)}}
.finish h1{font-size:30px;font-weight:900;color:var(--gold-d)}
.finish p{color:var(--muted);font-size:17px}
.fstats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:100%;margin-top:10px}
.fstat{border:2px solid var(--c);border-radius:16px;overflow:hidden;background:var(--c)}
.fstat span{display:block;color:#fff;font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;padding:6px 4px}
.fstat b{display:block;background:var(--surface);color:var(--c);font-size:22px;font-weight:900;padding:12px 4px;border-radius:13px;font-variant-numeric:tabular-nums}
.fgoal{width:100%;border:2px solid var(--line);border-radius:16px;padding:12px 16px;text-align:left}
.fgoal p{color:var(--ink);font-size:16px;font-weight:900;margin-bottom:8px}

.modal{position:fixed;inset:0;z-index:60;background:rgba(10,20,25,.45);display:flex;align-items:flex-end;justify-content:center;padding:16px;padding-bottom:calc(16px + env(safe-area-inset-bottom,0px))}
.sheet{background:var(--surface);border:2px solid var(--line);border-radius:22px;width:100%;max-width:520px;padding:22px;display:flex;flex-direction:column;gap:14px;animation:up .25s ease-out;max-height:calc(100% - 20px);overflow:auto}
.sheet h2{font-size:23px;font-weight:900}
.sheet p{color:var(--muted);font-size:16px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:2px solid var(--line);border-radius:10px;padding:4px 10px;font-size:15px}
.sheet .btns{display:flex;flex-direction:column;gap:12px;margin-top:4px}
.sheet .big-heart{display:flex;justify-content:center;color:var(--red)}
.sheet .big-heart .icon{width:70px;height:70px}
.course-row{display:flex;align-items:center;gap:14px;border:2px solid var(--line);border-radius:16px;padding:12px 14px}
.course-row .ct{flex:1}
.course-row b{display:block;font-size:18px;font-weight:900}
.course-row span{color:var(--muted);font-size:14px}
.course-row .btn{min-height:42px;padding:10px 14px;font-size:13px}
.course-row.active{border-color:var(--blue);background:var(--blue-bg)}

.toast{position:fixed;left:50%;bottom:110px;transform:translateX(-50%);z-index:70;background:var(--ink);color:var(--bg);padding:12px 18px;border-radius:14px;font-weight:800;max-width:calc(100% - 32px);text-align:center;animation:up .2s ease-out}

@media (max-width:420px){
  .pick-grid{gap:10px}
  .wrow{grid-template-columns:28px 1fr 1fr 38px;gap:8px;padding-left:12px}
  .greet svg.mascot{width:66px}
  .gchips{grid-template-columns:repeat(2,1fr)}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}
