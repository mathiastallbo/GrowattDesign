const HAS_TTS="speechSynthesis" in window&&typeof SpeechSynthesisUtterance!=="undefined";
function speak(text,slow){
  if(!HAS_TTS||!DB.current||!U().course)return;
  try{speechSynthesis.cancel();const L=LANG();
    const u=new SpeechSynthesisUtterance(text);u.lang=L.tts;u.rate=slow?0.55:0.9;
    const v=speechSynthesis.getVoices().find(v=>v.lang&&v.lang.toLowerCase().startsWith(L.code));if(v)u.voice=v;
    speechSynthesis.speak(u);}catch(e){}
}
