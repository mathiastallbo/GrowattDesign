function openModal(html,sticky){const m=$("#modal");m.innerHTML=html;m.hidden=false;
  m.onclick=e=>{if(e.target===m&&!sticky)closeModal();};const f=m.querySelector("button");if(f)f.focus();}
function closeModal(){const m=$("#modal");m.hidden=true;m.innerHTML="";}

/* ================= Övningar ================= */
/* Hittar felaktiga alternativ som liknar det rätta svaret */
const plainT=s=>s.toLowerCase().replace(/^(der|die|das|el|la|los|las|le|les)\s+/,"").replace(/^l'/,"").replace(/ß/g,"ss").normalize("NFD").replace(/[\u0300-\u036f]/g,"");
function artOfT(t){const m=t.match(LANG().artRe);return m?m[1].toLowerCase():"";}
function simScore(a,b){
  const x=plainT(a.t),y=plainT(b.t);
  let s=lev(x,y)/Math.max(x.length,y.length);
  if(x[0]===y[0])s-=.15;
  if(x.slice(-2)===y.slice(-2))s-=.12;
  if(artOfT(a.t)&&artOfT(a.t)===artOfT(b.t))s-=.08;
  if(Math.abs(x.length-y.length)<=2)s-=.05;
  return s;
}
function similar(w,pool,k){
  const seenT=new Set([w.t.toLowerCase()]),seenSv=new Set([w.sv]),c=[];
  for(const x of pool){const t=x.t.toLowerCase();if(seenT.has(t)||seenSv.has(x.sv))continue;seenT.add(t);seenSv.add(x.sv);c.push(x);}
  c.sort((a,b)=>simScore(w,a)-simScore(w,b));
  return shuffle(c.slice(0,k+2)).slice(0,k);
}
function wrongArticle(t){
  const L=LANG(),m=t.match(L.artRe);if(!m)return null;
  const a=m[1].toLowerCase();
  if(L.code==="fr"&&(a==="l'"||a==="les"))return null;
  const arts=L.code==="de"?["der","die","das"]:L.code==="fr"?["le","la"]:(a.endsWith("s")?["los","las"]:["el","la"]);
  return shuffle(arts.filter(x=>x!==a))[0]+" "+m[2];
}
/* Felaktiga alternativ: i första hand ord från samma tema (svårt att gissa på betydelsen),
   plus en "fälla" som liknar det rätta ordet i stavning eller har fel artikel. */
const plainSv=s=>s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"");
function okDistractor(w,x,out){return x&&x.sv!==w.sv&&x.t.toLowerCase()!==w.t.toLowerCase()&&!out.some(o=>o.sv===x.sv||o.t.toLowerCase()===x.t.toLowerCase());}
function lookalikeSv(w,pool){ /* svenskt ord som ser ut som det främmande ordet */
  const tt=plainT(w.t);let best=null,bs=1;
  for(const x of pool){if(x.sv===w.sv)continue;const y=plainSv(x.sv);const sc=lev(tt,y)/Math.max(tt.length,y.length);if(sc<bs){bs=sc;best=x;}}
  return bs<.55?best:null;
}
function distractors(w,ctx,k,dir){
  const out=[],add=x=>{if(out.length<k&&okDistractor(w,x,out))out.push(x);};
  if(dir==="t"){const wa=wrongArticle(w.t);if(wa&&Math.random()<.7)add({t:wa,sv:"\u0000"+wa});add(similar(w,ctx.pool,1)[0]);}
  else if(Math.random()<.6)add(lookalikeSv(w,ctx.pool));
  shuffle(ctx.lesson).forEach(add);
  shuffle(ctx.unit).forEach(add);
  similar(w,ctx.pool,k+3).forEach(add);
  return out;
}
function mkPick(w,ctx){return{type:"pick",word:w,options:shuffle([w,...distractors(w,ctx,3,"sv")])};}
function mkChoice(w,ctx){return{type:"choice",word:w,options:shuffle([w.sv,...distractors(w,ctx,3,"sv").map(x=>x.sv)])};}
function mkRChoice(w,ctx){return{type:"rchoice",word:w,options:shuffle([w.t,...distractors(w,ctx,3,"t").map(x=>x.t)])};}
function mkMatch(ws){return{type:"match",pairs:ws};}
function mkType(w){return{type:"type",word:w};}
function mkBank(s,from,type){
  const target=(type==="listen"||from==="sv")?"t":"sv";
  const ans=tok(s[target]),low=new Set(ans.map(x=>x.toLowerCase())),extra=[];
  const add=x=>{const l=x.toLowerCase();if(!low.has(l)&&!extra.some(e=>e.toLowerCase()===l))extra.push(x);};
  /* lurigare brickor: fel artikel, fel verbform eller fel pronomen */
  const groups=target==="sv"?[["en","ett"],["är","har"],["jag","du","vi","han","hon"],["den","det"],["min","mitt","mina"]]
    :U().course==="de"?[["der","die","das","den","dem"],["ein","eine","einen"],["ist","sind","bin"],["ich","du","wir","er","sie"],["mein","meine","meinen"]]
    :U().course==="fr"?[["le","la","les"],["un","une","des"],["est","sont","suis"],["je","tu","nous","il","elle"],["mon","ma","mes"],["du","de","au"]]
    :[["el","la","los","las"],["un","una"],["es","son","soy"],["mi","mis","tu"],["en","de","a"]];
  for(const tk of shuffle(ans)){
    const g=groups.find(g=>g.includes(tk.toLowerCase()));if(!g)continue;
    const alt=shuffle(g.filter(x=>x!==tk.toLowerCase()))[0];
    add(tk[0]!==tk[0].toLowerCase()?alt[0].toUpperCase()+alt.slice(1):alt);
    if(extra.length>=2)break;
  }
  /* ord från meningar som liknar den rätta */
  const want=ans.length<=3?4:5;
  const others=COURSE().sents.filter(x=>x!==s)
    .map(x=>({x,o:tok(x[target]).filter(w=>low.has(w.toLowerCase())).length+Math.random()*.8}))
    .sort((a,b)=>b.o-a.o);
  for(const {x} of others){if(extra.length>=want)break;for(const w of shuffle(tok(x[target]))){if(extra.length>=want)break;add(w);}}
  return{type:type||"bank",sent:s,from,target,tiles:shuffle([...ans,...extra])};
}
const listenOr=s=>HAS_TTS?mkBank(s,"t","listen"):mkBank(s,"sv");
function regen(ex){const c=Object.assign({},ex);if(c.options)c.options=shuffle(c.options);if(c.tiles)c.tiles=shuffle(c.tiles);if(c.pairs)c.pairs=shuffle(c.pairs);return c;}
function buildExercises(words,sents,long,ctx){
  const w=shuffle(words),s=shuffle(sents),W=i=>w[i%w.length],S=i=>s[i%s.length];
  const lvl=ctx.level||0; /* 0 = A1, 1 = A2, 2 = B1, 3 = B2 */
  const out=[
    mkPick(W(0),ctx),
    lvl>=2?mkRChoice(W(1),ctx):mkPick(W(1),ctx),
    mkChoice(W(2),ctx),
    mkMatch(shuffle(words).slice(0,5)),
    lvl>=1?mkType(W(3)):mkPick(W(3),ctx),
    mkBank(S(0),"sv"),
    mkRChoice(W(4),ctx),
    mkType(W(5)),
    mkBank(S(1),"t"),
    lvl>=3?mkType(W(0)):mkChoice(W(0),ctx),
    listenOr(S(2)),
    mkType(W(1)),
    mkRChoice(W(2),ctx),
    mkBank(S(3),"sv")];
  if(long)out.push(mkMatch(shuffle(words).slice(0,5)),mkType(W(6)),mkBank(S(4),"t"),mkRChoice(W(7),ctx),listenOr(S(5)),mkType(W(8)),mkBank(S(6),"sv"));
  return out;
}

