  const L1=shuffle(ex.pairs),R1=shuffle(ex.pairs);
  root.innerHTML=`<h1 class="q-title">Para ihop orden</h1><div class="match">
   <div class="col">${L1.map((w,i)=>`<button class="opt mbtn" data-s="l" data-i="${i}">${esc(w.t)}</button>`).join("")}</div>
   <div class="col">${R1.map((w,i)=>`<button class="opt mbtn" data-s="r" data-i="${i}">${esc(w.sv)}</button>`).join("")}</div></div>`;
  let sl=null,sr=null,left=ex.pairs.length;
  const btn=(s,i)=>root.querySelector(`.mbtn[data-s="${s}"][data-i="${i}"]`);
  const test=()=>{
    if(sl===null||sr===null)return;
    const a=btn("l",sl),b=btn("r",sr);
    if(L1[sl]===R1[sr]){
      [a,b].forEach(x=>{x.classList.remove("sel");x.classList.add("flash");x.disabled=true;});
      sfx("good");setTimeout(()=>[a,b].forEach(x=>{x.classList.remove("flash");x.classList.add("gone");}),450);
      left--;if(left===0)setTimeout(autoCheck,500);
    }else{
      [a,b].forEach(x=>{x.classList.remove("sel");x.classList.add("wrong");});sfx("bad");
      setTimeout(()=>[a,b].forEach(x=>x.classList.remove("wrong")),500);
    }
    sl=sr=null;
  };
  root.querySelectorAll(".mbtn").forEach(b=>b.onclick=()=>{
    const s=b.dataset.s,i=+b.dataset.i;
    root.querySelectorAll(`.mbtn[data-s="${s}"]`).forEach(x=>x.classList.remove("sel"));
    b.classList.add("sel");
    if(s==="l"){sl=i;speak(L1[i].t);}else{sr=i;sfx("tap");}
    test();
  });
  return{check(){return{ok:true,matchDone:true};}};
};

/* ================= Lektionsmotor ================= */
let LS=null;
const lessonEl=$("#lesson"),lbody=$("#lbody"),lfoot=$("#lfoot"),mainBtn=$("#mainBtn"),fbox=$("#fbox");
$("#quitBtn").innerHTML=IC.x;
function setReady(v){if(LS&&LS.state==="answer")mainBtn.disabled=!v;}

function saveResume(){
  if(!LS||LS.state==="finished")return;
  const u=U();
  u.resume={course:u.course,nodeId:LS.node.id,practiceNode:LS.practice?LS.node:null,queue:[LS.ex,...LS.queue],
    done:LS.done,mistakes:LS.mistakes,combo:LS.combo,total:LS.total,elapsed:Date.now()-LS.start};
  save();
}
function clearResume(){const u=DB.current&&U();if(u&&u.resume){delete u.resume;save();}}
function resumeLesson(){
  const u=U(),r=u.resume;
  if(LS||!r||r.course!==u.course)return false;
  const node=r.practiceNode||COURSE().nodes.find(n=>n.id===r.nodeId);
  if(!node||!r.queue||!r.queue.length){clearResume();return false;}
  LS={node,practice:!!r.practiceNode,queue:r.queue,done:r.done,mistakes:r.mistakes,combo:r.combo,total:r.total,start:Date.now()-(r.elapsed||0),state:"answer"};
  lessonEl.hidden=false;document.body.style.overflow="hidden";
  updateLessonTop();nextEx();
  toast(`Välkommen tillbaka, ${u.name}! Du fortsätter där du slutade.`);
  return true;
}
function ctxFor(node){
  if(node.unit==null)return{lesson:node.words,unit:node.words,pool:node.words,level:0};
  const C=COURSE(),un=C.units[node.unit].nodes.filter(n=>!n.test);
  const unitWords=un.flatMap(n=>n.words);
  return{lesson:node.test?unitWords:node.words,unit:unitWords,
    pool:C.nodes.filter(n=>!n.test&&n.unit<=node.unit+1).flatMap(n=>n.words),level:Math.floor(node.unit/5)};
}
function startLesson(node,practice){
  LS={node,practice,queue:buildExercises(node.words,node.sents,!!node.test,ctxFor(node)),done:0,mistakes:0,combo:0,start:Date.now(),state:"answer"};
  LS.total=LS.queue.length;
  lessonEl.hidden=false;document.body.style.overflow="hidden";
  updateLessonTop();nextEx();
}
function startPractice(){
  const c=CS(),learned=COURSE().nodes.filter(n=>!n.test&&c.done[n.id]);
  if(!learned.length){toast("Klara en lektion först.");return;}
  startLesson({id:"practice",name:"Repetition",words:shuffle(learned.flatMap(l=>l.words)).slice(0,8),sents:shuffle(learned.flatMap(l=>l.sents)).slice(0,5)},true);
}
function updateLessonTop(){
  $("#pfill").style.width=(LS?LS.done/LS.total*100:0)+"%";
  const lh=$("#lHearts");
  if(LS&&LS.practice){lh.className="lhearts inf";lh.innerHTML=IC.infinity;}
  else{lh.className="lhearts";lh.innerHTML=IC.heart+U().hearts;}
  const c=$("#combo");
  if(LS&&LS.combo>=3){c.textContent=LS.combo>=5?`${LS.combo} i rad, ${U().name}!`:`${LS.combo} i rad!`;c.classList.add("on");}else c.classList.remove("on");
}
function nextEx(){
  if(!LS.queue.length){finishLesson();return;}
  LS.ex=LS.queue.shift();LS.state="answer";saveResume();
  lfoot.className="lfoot";fbox.hidden=true;fbox.innerHTML="";
  mainBtn.textContent="Kontrollera";mainBtn.disabled=true;mainBtn.hidden=(LS.ex.type==="match");
  lbody.innerHTML=`<div class="lbody-in"></div>`;lbody.scrollTop=0;
  LS.ctl=RENDER[LS.ex.type](LS.ex,lbody.firstChild,setReady,()=>{if(LS&&LS.state==="answer")doCheck(true);});
}
function onMain(){
  if(!LS)return;
  if(LS.state==="answer"){if(!mainBtn.disabled)doCheck();}
  else if(LS.state==="feedback")cont();
  else if(LS.state==="finished")closeLesson();
}
mainBtn.onclick=onMain;
function praiseTitle(){
  const n=U().name;
  return pick(Math.random()<.55
    ?[`Bra jobbat, ${n}!`,`Snyggt, ${n}!`,`Helt rätt, ${n}!`,`Du är grym, ${n}!`,`Perfekt, ${n}!`]
    :["Helt rätt!","Snyggt!","Perfekt!",...LANG().cheer]);
}
function doCheck(auto){
  if(!auto&&mainBtn.disabled)return;
  const r=LS.ctl.check(),u=U();LS.state="feedback";
  lbody.querySelectorAll("button:not(.spk),textarea").forEach(b=>b.disabled=true);
  if(r.ok){LS.done++;LS.combo++;sfx("good");}
  else{
    LS.mistakes++;LS.combo=0;sfx("bad");
    if(!LS.practice){u.hearts=Math.max(0,u.hearts-1);save();renderTop();
      const lh=$("#lHearts");lh.classList.remove("hit");void lh.offsetWidth;lh.classList.add("hit");}
    LS.queue.push(regen(LS.ex));
  }
  if(r.say)setTimeout(()=>speak(r.say),200);
  const text=r.ok?(r.note||(r.matchDone?"Alla par stämmer.":"")):
    `Rätt svar: <b>${LS.ex.type==="type"?artHTML(r.answer):esc(r.answer)}</b>${r.extra?`<br>(${esc(r.extra)})`:""}${r.note?`<br>${r.note}`:""}`;
  const title=r.ok?praiseTitle():pick(["Inte riktigt","Nästan, "+u.name,"Oj, inte den"]);
  fbox.innerHTML=`<div class="fbadge">${r.ok?IC.check:IC.x}</div><div><p class="ftitle">${esc(title)}</p>${text?`<p class="ftext">${text}</p>`:""}</div>`;
  fbox.hidden=false;lfoot.className="lfoot "+(r.ok?"ok":"bad");
  mainBtn.hidden=false;mainBtn.disabled=false;mainBtn.textContent=r.ok?"Fortsätt":"Uppfattat";
  updateLessonTop();setTimeout(()=>mainBtn.focus(),30);
}
function cont(){if(!LS.practice&&U().hearts<=0){outOfHearts();return;}nextEx();}
function outOfHearts(){
  openModal(`<div class="sheet"><div class="big-heart">${IC.heart}</div><h2 style="text-align:center">Slut på hjärtan</h2>
    <p style="text-align:center">Ingen fara, ${NAME()}. Alla gör fel när de lär sig. Fyll på hjärtan och fortsätt där du var, eller ta en paus.</p>
    <div class="btns"><button class="btn blue wide" id="refill">Fyll på hjärtan</button><button class="btn ghost wide" id="giveup">Avsluta lektionen</button></div></div>`,true);
  $("#refill").onclick=()=>{U().hearts=5;save();renderTop();closeModal();updateLessonTop();nextEx();};
  $("#giveup").onclick=()=>{closeModal();closeLesson();};
}
function finishLesson(){
  const u=U(),c=CS(),n=LS.node;LS.state="finished";sfx("win");delete u.resume;
  if(!LS.practice)c.done[n.id]=(c.done[n.id]||0)+1;
  u.hearts=Math.min(5,u.hearts+1);
  const today=dayStr();
  if(u.lastDay!==today){u.streak=(u.lastDay===yesterday())?u.streak+1:1;u.lastDay=today;}
  save();renderTop();
  const acc=Math.round(LS.done/(LS.done+LS.mistakes)*100),secs=Math.round((Date.now()-LS.start)/1000);
  const nm=NAME();
  const title=n.test?`Enhetsprovet klart, ${nm}!`:LS.practice?`Bra repeterat, ${nm}!`:(LS.mistakes===0?`Felfritt, ${nm}!`:`Lektionen klar, ${nm}!`);
  const line=LS.mistakes===0?"Inga fel alls.":`Du gjorde ${LS.mistakes} fel och rättade dem alla.`;
  $("#pfill").style.width="100%";lfoot.className="lfoot";fbox.hidden=true;$("#combo").classList.remove("on");
  lbody.innerHTML=`<div class="lbody-in"><div class="finish">${LANG().mascot()}
    <h1>${title}</h1><p>${line}</p>
    <div class="fstats">
      <div class="fstat" style="--c:var(--orange)"><span>I rad</span><b>${u.streak} ${u.streak===1?"dag":"dgr"}</b></div>
      <div class="fstat" style="--c:var(--green)"><span>Rätt</span><b>${acc}%</b></div>
      <div class="fstat" style="--c:var(--blue)"><span>Tid</span><b>${Math.floor(secs/60)}:${String(secs%60).padStart(2,"0")}</b></div>
    </div>
    </div></div>`;
  mainBtn.hidden=false;mainBtn.disabled=false;mainBtn.textContent="Fortsätt";
}
function closeLesson(){
  clearResume();LS=null;lessonEl.hidden=true;document.body.style.overflow="";
  try{speechSynthesis.cancel();}catch(e){}
  render();
}
$("#quitBtn").onclick=()=>{
  if(!LS||LS.state==="finished"){closeLesson();return;}
  openModal(`<div class="sheet"><div style="width:110px;align-self:center">${LANG().mascot("sad")}</div>
    <h2 style="text-align:center">Vänta, ${NAME()}! Du är på god väg.</h2><p style="text-align:center">Avslutar du nu försvinner framstegen i den här lektionen.</p>
    <div class="btns"><button class="btn blue wide" id="stay">Fortsätt öva</button><button class="btn ghost wide" id="leave" style="color:var(--red)">Avsluta</button></div></div>`);
  $("#stay").onclick=closeModal;
  $("#leave").onclick=()=>{closeModal();closeLesson();};
};

document.addEventListener("keydown",e=>{
  if(!LS||!$("#modal").hidden)return;
  if(e.target.tagName==="TEXTAREA")return;
  if(e.key==="Enter"){e.preventDefault();onMain();}
  else if(/^[1-4]$/.test(e.key)&&LS.state==="answer"&&LS.ctl&&LS.ctl.key)LS.ctl.key(+e.key);
});

/* ================= Start ================= */
if(DB.current&&DB.users[DB.current]&&U().course&&U().courses[U().course])enterApp(true);
else{DB.current=null;renderLogin();}
</script>
