function newUser(name){
  const u={name,hearts:5,streak:0,lastDay:null,course:null,courses:{},color:null};
  const cols=["--green","--blue","--purple","--orange","--pink","--teal"];
  let h=0;for(const ch of name)h=(h*31+ch.charCodeAt(0))>>>0;u.color=cols[h%cols.length];
  /* ta med framsteg från den gamla tyska versionen om den finns */
  try{const old=JSON.parse(localStorage.getItem("brezel-tyska-v1")||"null");
    if(old&&!Object.keys(DB.users).length&&old.done&&Object.keys(old.done).length){
      u.courses.de={done:old.done,start:0,reason:null};u.streak=old.streak||0;u.lastDay=old.lastDay||null;u.hearts=old.hearts??5;}}catch(e){}
