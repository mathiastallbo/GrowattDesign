}

function dayStr(d){d=d||new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");}
function yesterday(){const d=new Date();d.setDate(d.getDate()-1);return dayStr(d);}
function streakNow(){const u=U();return (u.lastDay===dayStr()||u.lastDay===yesterday())?u.streak:0;}
function curIdx(){const c=CS(),n=COURSE().nodes;const i=n.findIndex(x=>x.idx>=c.start&&!c.done[x.id]);return i<0?n.length:i;}
function nodeState(n){const c=CS(),cur=curIdx();if(c.done[n.id])return"done";if(n.idx===cur)return"current";if(n.idx<cur)return"open";return"locked";}

