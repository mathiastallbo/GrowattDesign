let ONB=null;
function startOnboarding(mode,lang){
  ONB={mode,lang:lang||null,reason:null,i:0};
  ONB.steps=mode==="new"?["lang","reason","ready"]:["reason","ready"];
  showAuth();renderOnb();
}
function renderOnb(){
  const u=U(),st=ONB.steps[ONB.i],n=esc(u.name);
  const L=ONB.lang?LANGS[ONB.lang]:null;
  const Masc=L?L.mascot:brezel;
  let body="",ready=false;
  if(st==="lang"){
    body=`<div class="prompt">${brezel()}<div class="bubble plain">Hej ${n}! Vilket språk vill du lära dig?</div></div>
      <div class="rows">${Object.values(LANGS).map(l=>`<button class="opt row plain ${ONB.lang===l.code?"sel":""}" data-v="${l.code}">${l.flag.replace('class="flag','class="flag big')}<div><b style="font-size:20px">${l.name}</b><small>${LESSON_COUNT} lektioner och prov · ${l.mascotName} hänger med</small></div></button>`).join("")}</div>`;
    ready=!!ONB.lang;
  }else if(st==="reason"){
    body=`<div class="prompt">${Masc()}<div class="bubble plain">Varför vill du lära dig ${L.lower}, ${n}?</div></div>
      <div class="rows">${Object.entries(REASONS).map(([k,r])=>`<button class="opt row plain ${ONB.reason===k?"sel":""}" data-v="${k}"><span class="lead">${r.e}</span>${r.label}</button>`).join("")}</div>`;
    ready=!!ONB.reason;
  }else if(st==="ready"){
    body=`<div class="finish" style="padding-top:0">${Masc()}<h1 style="color:var(--green)">Allt klart, ${n}!</h1>
      <p>${REASONS[ONB.reason].line}</p></div>
      <div class="summary"><div><span>Kurs</span><b>${L.name}</b></div>
      <div><span>Du börjar på</span><b>Enhet 1: ${DATA[0].title}</b></div></div>`;
    ready=true;
  }
  const pct=(ONB.i+1)/ONB.steps.length*100;
  $("#authIn").innerHTML=`<div class="onb-head"><button class="backbtn" id="onbBack" aria-label="Tillbaka">${IC.back}</button><div class="onb-bar"><i style="width:${pct}%"></i></div></div>
    <div class="onb-body">${body}</div>
    <div class="onb-foot"><button class="btn wide" id="onbNext" ${ready?"":"disabled"}>${st==="ready"?"Börja lära dig":"Fortsätt"}</button></div>`;
  document.querySelectorAll(".onb-body .opt").forEach(b=>b.onclick=()=>{
    const v=b.dataset.v;sfx("tap");
    if(st==="lang")ONB.lang=v;else if(st==="reason")ONB.reason=v;
    renderOnb();
  });
  $("#onbBack").onclick=()=>{
    if(ONB.i>0){ONB.i--;renderOnb();}
    else if(ONB.mode==="new"){DB.current=null;save();renderLogin();}
    else{ONB=null;enterApp();}
  };
  $("#onbNext").onclick=()=>{
    if(st==="lang"&&U().courses[ONB.lang]){ /* kursen fanns redan (t.ex. importerad) */
      ONB.steps=["lang","done"];}
    if(st==="ready"||ONB.steps[ONB.i+1]==="done"){finishOnb();return;}
    ONB.i++;renderOnb();
  };
}
function finishOnb(){
  const u=U();
  if(!u.courses[ONB.lang]){
    u.courses[ONB.lang]={done:{},start:0,reason:ONB.reason};
  }
  u.course=ONB.lang;ONB=null;save();
  enterApp(true);
  /* ny kurs: hoppa direkt in i första lektionen */
  const c=CS();if(!Object.keys(c.done).length&&!LS)startLesson(COURSE().nodes[0],false);
}

