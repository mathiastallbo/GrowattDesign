function buildCourse(code){
  const wi=code==="de"?2:3, si=code==="de"?1:2;
  const fw=(l,a,i)=>code==="fr"?FR[l.id][0][i]:a[wi];
  const fs=(l,a,i)=>code==="fr"?FR[l.id][1][i]:a[si];
  const units=DATA.map((u,ui)=>{
    const lessons=u.lessons.map(l=>({id:l.id,name:l.name,
      words:l.w.map((a,i)=>({e:a[0],sv:a[1],t:fw(l,a,i)})),
      sents:l.s.map((a,i)=>({sv:a[0],t:fs(l,a,i)}))}));
    const test={id:"prov"+(ui+1),name:"Enhetsprov",test:true,words:lessons.flatMap(l=>l.words),sents:lessons.flatMap(l=>l.sents)};
    return Object.assign({},u,{nodes:[...lessons,test]});
  });
  const nodes=[];
  units.forEach((u,ui)=>u.nodes.forEach((n,ni)=>{n.unit=ui;n.ni=ni;n.idx=nodes.length;nodes.push(n);}));
  return{units,nodes,sents:nodes.filter(n=>!n.test).flatMap(n=>n.sents)};
}
